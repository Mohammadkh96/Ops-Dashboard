# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL="postgresql://opsos:opsos_dev_password@localhost:5432/opsos?schema=public"

# Redis (queues / real-time fan-out)
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="8h"

# API server
PORT=4000
WEB_ORIGIN="http://localhost:3000"

# ── Live payment data (Paymaxis cashier webhooks) ──
# The Signing Key from the Paymaxis shop screen. Used to verify an HMAC over the
# exact received bytes; callbacks that fail verification are rejected with 401.
PAYMAXIS_SIGNING_KEY=""
# Header carrying the signature, and the HMAC algorithm. Defaults shown; adjust
# once the real header is confirmed from captured traffic.
PAYMAXIS_SIGNATURE_HEADER="x-signature"
PAYMAXIS_SIGNATURE_ALGO="sha256"
# Set to 1 to ACCEPT AND STORE UNVERIFIED callbacks so the real payload shape
# and signature header can be observed. Use only while onboarding a provider —
# never in production, since anyone who finds the URL could inject events.
PAYMAXIS_WEBHOOK_CAPTURE="0"
# Set to false to turn the demo event simulator off entirely. It already stands
# down permanently as soon as the first real callback arrives.
LIVE_SIMULATE="true"

# Only needed for `prisma migrate diff --from-migrations`; omit otherwise.
SHADOW_DATABASE_URL=""

# ── Paymaxis read-only polling (live dashboard data) ──
# Shops as "shopId:apiKey" pairs. Adding a shop needs no code change.
# Paymaxis does not issue read-only keys — every key can also write — so the
# client is built with no way to express any verb other than GET.
PAYMAXIS_SHOPS=""
PAYMAXIS_POLL_ENABLED="0"
PAYMAXIS_POLL_SECONDS="60"
PAYMAXIS_BASE_URL="https://api.paymaxis.com"
PAYMAXIS_AUTH_HEADER="X-Api-Key"
# Endpoint + parameter names. Adjust to the real API without touching code.
PAYMAXIS_PAYMENTS_PATH="/api/v1/payment"
PAYMAXIS_SINCE_PARAM="updatedAtFrom"
PAYMAXIS_PAGE_PARAM="page"
PAYMAXIS_LIMIT_PARAM="limit"
# Response key holding the records array; auto-detected when unset.
PAYMAXIS_RECORDS_PATH=""
PAYMAXIS_LOOKBACK_MINUTES="60"
PAYMAXIS_MAX_PAGES="20"
PAYMAXIS_TIMEOUT_MS="20000"
