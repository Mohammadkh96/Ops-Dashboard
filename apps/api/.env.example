# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL="postgresql://opsos:opsos_dev_password@localhost:5432/opsos?schema=public"

# Redis (queues / real-time fan-out)
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="8h"

# API server
PORT=4000
# Comma-separated: the dashboard has a production domain and a distinct preview
# URL per deployment. A leading "*." allows a subdomain wildcard for previews —
# prefer exact origins in production, since credentials are enabled.
WEB_ORIGIN="http://localhost:3000"

# ── Live payment data (Paymaxis cashier webhooks) ──
# The Signing Key from the Paymaxis shop screen. Used to verify an HMAC over the
# exact received bytes; callbacks that fail verification are rejected with 401.
# Each shop has its OWN signing key, so list them per shop. The signature must
# be checked before the body can be trusted, so the shop is not yet known and
# every configured key is tried until one verifies.
PAYMAXIS_SIGNING_KEYS=""   # e.g. "5141=<key>,6321=<key>"
# Single-key form, still honoured for a one-shop setup.
PAYMAXIS_SIGNING_KEY=""
# Header carrying the signature, and the HMAC algorithm. Defaults shown; adjust
# once the real header is confirmed from captured traffic.
PAYMAXIS_SIGNATURE_HEADER="x-signature"
PAYMAXIS_SIGNATURE_ALGO="sha256"
# Set to 1 to ACCEPT AND STORE UNVERIFIED callbacks so the real payload shape
# and signature header can be observed. Use only while onboarding a provider —
# never in production, since anyone who finds the URL could inject events.
PAYMAXIS_WEBHOOK_CAPTURE="0"
# Set to false to turn the demo event simulator off entirely. It already stands
# down permanently as soon as the first real callback arrives.
LIVE_SIMULATE="true"

# Only needed for `prisma migrate diff --from-migrations`; omit otherwise.
SHADOW_DATABASE_URL=""

# ── Paymaxis read-only polling (live dashboard data) ──
# Shops as "shopId:apiKey" pairs (a JSON array of {shopId, apiKey} also works).
# Adding a shop needs no code change.
# Paymaxis does not issue read-only keys — every key can also write — so the
# client is built with no way to express any verb other than GET.
PAYMAXIS_SHOPS=""
PAYMAXIS_POLL_ENABLED="0"
PAYMAXIS_POLL_SECONDS="60"
# The values below are the ones CONFIRMED against the live API. The obvious
# guesses are all wrong in ways that misreport themselves, so do not "correct"
# them without re-running scripts/discover-paymaxis.mjs:
#   · api.paymaxis.com does not resolve at all — the host is app.paymaxis.com
#   · X-Api-Key is rejected with 401, which reads as a bad key; it wants Bearer
#   · /api/v1/payment (singular) returns 404; the list is /api/v1/payments
#   · offset is the ONLY pagination parameter honoured. page, skip, after,
#     startingAfter and startId are all accepted and silently ignored, so a
#     page-numbered poller re-reads the newest records forever
#   · no date-range filter exists; nine candidate names were accepted and
#     ignored, so SINCE_PARAM stays empty rather than sending a filter that
#     does nothing
# Leaving any of these unset uses the confirmed value as the default.
PAYMAXIS_BASE_URL="https://app.paymaxis.com"
PAYMAXIS_AUTH_HEADER="Authorization"
PAYMAXIS_PAYMENTS_PATH="/api/v1/payments"
PAYMAXIS_SINCE_PARAM=""
PAYMAXIS_PAGE_PARAM="offset"
PAYMAXIS_PAGE_MODE="offset"
PAYMAXIS_LIMIT_PARAM="limit"
# Response key holding the records array; auto-detected when unset.
PAYMAXIS_RECORDS_PATH=""
PAYMAXIS_LOOKBACK_MINUTES="60"
PAYMAXIS_MAX_PAGES="20"
PAYMAXIS_TIMEOUT_MS="20000"

# Historical import (Settings → Data → Import older history). The poll reads
# newest-first and stops at the first page it already knows, so payments older
# than the day polling started never arrive on their own; this walks the list
# backwards in slices, resuming from a stored cursor. Per slice: how long it may
# spend, and how many pages it may read. Keep the budget under the platform's
# request limit (Vercel: 60s).
PAYMAXIS_BACKFILL_BUDGET_MS="20000"
PAYMAXIS_BACKFILL_MAX_PAGES="25"

# Personal data is stripped from the stored raw payload by default (date of
# birth, IP, cardholder name, card expiry, tokens, 3-D Secure material). Set to
# "full" to keep everything — only sensible while debugging.
PAYMAXIS_STORE_RAW=""
PAYMAXIS_REDACT_KEYS=""

# ── Shift handover email ──
# The dashboard emails the handover to everyone active when a shift closes.
# Over HTTP rather than SMTP: a serverless function has no long-lived socket and
# managed hosts block port 25, so an SMTP client works on a laptop and fails
# silently in production.
#
# Three providers, tried in this order: the company Gmail, then Resend, then
# SendGrid. With NONE of them set the shift still closes and the handover is
# still recorded and readable in the dashboard — the close reports that it was
# not emailed and names the variable to set, rather than failing quietly.
#
# GMAIL IS PREFERRED. The handover goes out from an address the desk already
# recognises, it does not have to earn a sending reputation from scratch (a
# first send from a vendor domain lands in spam), and the sent copy is in the
# mailbox's Sent folder — which is where somebody looks when they ask whether
# it went.
#
# The easy way, which needs no Workspace administrator: run
#   node scripts/gmail-authorize.mjs
# signed in as the sending mailbox. It prints the three values below. It reuses
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET from the sign-in section, so add
# http://localhost:8910/callback to that OAuth client's redirect URIs first.
GMAIL_REFRESH_TOKEN=""
# The mailbox the handover is sent from. MAIL_FROM must agree with it — Gmail
# refuses a From the authenticated mailbox does not own rather than rewriting
# it, so a disagreement is corrected to this address with the display name kept.
GMAIL_SENDER=""
#
# The other way, if you administer the Workspace: a service account with
# domain-wide delegation, authorised for
# https://www.googleapis.com/auth/gmail.send, impersonating GMAIL_SENDER.
# Nothing to re-consent, but it takes a super-admin and the key can send as
# anybody in the domain. Paste either the whole key file, or the two fields.
GOOGLE_SERVICE_ACCOUNT_JSON=""
GMAIL_SERVICE_ACCOUNT_EMAIL=""
# Newlines may be written as \n — most environment editors cannot hold real ones.
GMAIL_PRIVATE_KEY=""
#
# Vendor fallbacks, used only when no Gmail is configured.
RESEND_API_KEY=""
SENDGRID_API_KEY=""
# The From address. It must be on a domain verified with the provider.
# Resend's shared sender (onboarding@resend.dev) is a SANDBOX: it only delivers
# to the address that owns the Resend account, so a handover sent to the team
# would reach nobody. Verify a real domain before relying on this.
MAIL_FROM="OpsOS <ops@yourdomain.com>"

# ── The shift desk ──
# Everything about a shift — which day it belongs to, which number it is — is
# computed in the desk's timezone, never the server's UTC. In Amman a handover
# at 00:05 is 21:05 UTC the previous day, so a date read off the server clock is
# simply the wrong one.
OPS_TIMEZONE="Asia/Amman"
# The hour the ops day rolls over. It must sit in a quiet gap between the last
# handover of one day and the first of the next — with handovers near 00:00 and
# 08:00, 04:00 leaves about four hours of slack either side, so ending a few
# minutes early or late never changes the day or the shift number.
OPS_DAY_START_HOUR="4"
# Target handover times, used ONLY to number the first shift of a day. After
# that the sequence simply counts up, so an agent handing over late is still the
# next shift rather than skipping a number.
OPS_HANDOVER_SLOTS="08:00,16:00,00:00"

# ── Signing in with a company Google account ──
# Optional. With these unset the dashboard shows only the email/password form —
# it asks the API (GET /auth/providers) rather than guessing, so an unconfigured
# deployment never shows a button that leads nowhere.
#
# In Google Cloud Console → APIs & Services → Credentials, create an OAuth 2.0
# Client ID of type "Web application" and register the callback below as an
# Authorised redirect URI, character for character. A mismatch is the single
# most common failure and Google reports it as redirect_uri_mismatch.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Which company domains may sign in. Comma-separated, checked against the `hd`
# CLAIM in the token Google issues AND the address itself.
#
# There is deliberately no "empty means everyone": leaving this blank refuses
# every sign-in. The alternative reading would admit every Google account in
# existence, which is not a mistake worth leaving available.
GOOGLE_ALLOWED_DOMAINS="yourcompany.com"
# The role a person gets the first time they sign in and have no account yet.
# READ_ONLY on purpose — everyone in the company can reach this door, so the
# default has to be the one that grants nothing. Promote them in Admin → Users.
# An EXISTING account keeps whatever role it already has.
GOOGLE_DEFAULT_ROLE="READ_ONLY"
# Where Google sends the browser back. Derived from API_PUBLIC_URL when unset,
# as ${API_PUBLIC_URL}/api/auth/google/callback.
GOOGLE_REDIRECT_URI=""
# This API's own public address, used for the line above and nothing else.
API_PUBLIC_URL="https://your-api.example.com"

# ── Direct PSP connections ──
# The Admin → Payment providers screen stores one connection per terminal
# ("Paystrax_Tradin SL"), with the provider's API key. Those keys go in the
# DATABASE, because the "Add PSP" button exists so a provider can be added
# without a redeploy — so they are encrypted first, with this key.
#
# Generate one and never change it casually: every credential stored under the
# old key becomes unreadable and has to be entered again.
#   openssl rand -base64 48
#
# Without it, provider credentials cannot be saved at all — the screen says so
# rather than failing halfway through a form.
CREDENTIALS_KEY=""
