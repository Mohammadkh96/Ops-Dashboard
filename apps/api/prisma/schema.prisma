generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Role {
  ADMIN
  OPERATIONS_MANAGER
  OPERATIONS
  COMPLIANCE
  SUPPORT
  FINANCE
  EXECUTIVE
  AUDITOR
  READ_ONLY
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
}

enum TransactionStatus {
  PENDING
  PROCESSING
  APPROVED
  DECLINED
  FAILED
  REFUNDED
  REVIEW
}

enum PaymentMethod {
  CARD
  CRYPTO
  BANK
  LOCAL_PAYMENT
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum GatewayStatus {
  OPERATIONAL
  DEGRADED
  DOWN
}

enum KycStatus {
  NOT_STARTED
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  EDD_REQUIRED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  CLOSED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  ESCALATED
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ShiftStatus {
  ACTIVE
  ENDED
}

// ---------- Core identity ----------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  /// Bcrypt hash. An account created by Google sign-in stores unusable text
  /// here rather than null: the column stays required, and bcrypt.compare
  /// against it fails for every input, so the account can only be reached
  /// through Google.
  passwordHash String
  /// Google's stable subject id, recorded on first Google sign-in. Sign-in
  /// matches on the verified email — this is here so it is visible which
  /// accounts use that door, and so a re-used email cannot silently inherit
  /// a different person's account.
  googleId     String?  @unique
  firstName    String
  lastName     String
  role         Role     @default(OPERATIONS)
  isActive     Boolean  @default(true)

  /// A SECOND password, for the Admin tab only. Bcrypt, like the first.
  ///
  /// Separate from the sign-in password on purpose. A session left open on an
  /// unlocked laptop is the ordinary way an operations dashboard gets misused,
  /// and being signed in should not be the same thing as being able to change
  /// roles, read the audit trail or touch provider credentials. This is the
  /// step somebody has to take deliberately, and it expires on its own.
  ///
  /// Its own passphrase rather than re-typing the sign-in one, because an
  /// account created through Google sign-in HAS no sign-in password — asking
  /// for it would lock every Google user out of the Admin tab permanently.
  adminPassHash  String?
  adminPassSetAt DateTime?
  /// Consecutive failed unlock attempts, and when the lockout lifts. A second
  /// password is worth nothing if it can be guessed a thousand times a minute
  /// by somebody who already has a session.
  adminFails     Int       @default(0)
  adminLockedUntil DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shifts            Shift[]
  shiftsJoined      ShiftParticipant[]
  assignedTasks     ShiftTask[] @relation("TaskAssignee")
  auditLogs         AuditLog[]
  assignedTickets   Ticket[]   @relation("TicketAssignee")
  assignedIncidents Incident[] @relation("IncidentOwner")
  assignedKycCases  KycCase[]  @relation("KycAssignee")

  @@index([role])
}

/// One shift on the desk, from takeover to handover.
///
/// A shift is SHARED, not personal. One is open at a time and everybody on
/// duty joins it, because that is how the desk actually works: three people
/// covering the same hours are one shift with three pairs of hands, not three
/// shifts. Actions are attributed to the person who took them; the shift is
/// the container they all happened in.
model Shift {
  id        String      @id @default(cuid())
  /// Which ops day this shift's HANDOVER belongs to (yyyy-mm-dd, desk time,
  /// rolling over at 04:00). Set when the shift ends — a shift that started
  /// at 20:00 hands over after midnight and belongs to the day it started.
  opsDay    String?
  /// Position within that ops day: 1, 2, 3... See ops-day.ts for why this is
  /// not simply "the third shift we recorded".
  slot      Int?
  /// Morning / Evening / Night / Ad Hoc — chosen by the agent, not the clock.
  name      String      @default("Ad Hoc")
  status    ShiftStatus @default(ACTIVE)

  /// Who opened it. Everyone else joins.
  user      User        @relation(fields: [userId], references: [id])
  userId    String
  /// Who handed over TO this shift, and who this shift handed over to. Names
  /// rather than ids: a handover can be to somebody who has not signed in yet.
  takenOverFrom String?
  handoverTo    String?

  startedAt DateTime    @default(now())
  endedAt   DateTime?
  /// Who pressed End. Not always the person who started it.
  endedBy   String?

  /// Live PSP balances at takeover, { "psp name": amount }. The opening
  /// position the next shift is measured against.
  startBalances Json?
  startNotes    String?

  /// The handover this shift's opener read before starting, and when.
  ///
  /// The email has no read receipt: it goes out and nobody knows whether the
  /// incoming agent opened it. Showing the previous handover at Start shift
  /// does, and this is where that fact lives — so "was the night shift told
  /// about the PSP outage?" has an answer rather than an assumption.
  ///
  /// Null means it was not read, which happens honestly: the first shift of
  /// all, or a handover the dashboard could not build at that moment. Never
  /// backfilled, because a guess here is worse than a gap.
  readHandoverOf String?
  handoverReadAt DateTime?

  /// Closing KYC/onboarding snapshot per entity, as the desk records it.
  kyc       Json?
  /// Support tickets the next shift needs to know about. Carried in the
  /// handover rather than stored as first-class tickets: they live in Zendesk,
  /// and duplicating them here would create a second, staler copy.
  tickets   Json        @default("[]")
  /// What the next agent needs to know.
  notes     String?

  participants ShiftParticipant[]
  tasks        ShiftTask[]

  @@index([userId, status])
  @@index([status])
  @@index([opsDay])
  @@index([startedAt])
}

/// Somebody who worked a shift. The opener is one of these too.
model ShiftParticipant {
  id       String   @id @default(cuid())
  shift    Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  shiftId  String
  user     User     @relation(fields: [userId], references: [id])
  userId   String
  joinedAt DateTime @default(now())
  leftAt   DateTime?

  @@unique([shiftId, userId])
  @@index([userId])
}

/// A standing task the desk does every shift — the task library.
///
/// Kept separate from the tasks themselves so that editing "how to check this"
/// updates the instruction everywhere without rewriting history: a task done
/// last Tuesday keeps the wording that was in front of the person doing it.
model TaskTemplate {
  id        String   @id @default(cuid())
  title     String
  /// The instructions, shown with the task. The reason this system beats a
  /// checklist: what to do is attached to the thing to do.
  howTo     String?
  category  String   @default("Operations")
  /// Which shift it applies to, or "All Shifts".
  appliesTo String   @default("All Shifts")
  priority  String   @default("Medium")
  active    Boolean  @default(true)
  /// Manual ordering, so the list reads in the order the work is done.
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks ShiftTask[]

  @@index([active])
}

/// One task on one shift.
model ShiftTask {
  id         String   @id @default(cuid())
  shift      Shift?   @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  shiftId    String?
  /// Where it came from, when it came from the library. Null for ad-hoc work.
  template   TaskTemplate? @relation(fields: [templateId], references: [id])
  templateId String?

  /// Copied from the template at creation, not read through it — see above.
  title    String
  howTo    String?
  category String  @default("Operations")
  priority String  @default("Medium")
  /// Pending / In Progress / Blocked / Done
  status   String  @default("Pending")
  notes    String?

  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])
  assigneeId String?
  /// Who marked it done — not necessarily who it was assigned to.
  completedBy String?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shiftId, status])
  @@index([assigneeId])
}

// ---------- Clients & compliance ----------

model Client {
  id         String    @id @default(cuid())
  externalId String?   @unique
  fullName   String
  email      String?
  country    String?
  riskLevel  RiskLevel @default(LOW)
  riskScore  Int       @default(0)
  kycStatus  KycStatus @default(NOT_STARTED)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  transactions Transaction[]
  kycCases     KycCase[]
  tickets      Ticket[]
  incidents    Incident[]

  @@index([riskLevel])
  @@index([kycStatus])
}

model KycCase {
  id           String    @id @default(cuid())
  client       Client    @relation(fields: [clientId], references: [id])
  clientId     String
  status       KycStatus @default(PENDING)
  riskScore    Int       @default(0)
  assignedTo   User?     @relation("KycAssignee", fields: [assignedToId], references: [id])
  assignedToId String?
  submittedAt  DateTime  @default(now())
  reviewedAt   DateTime?
  notes        String?

  @@index([status])
  @@index([clientId])
}

// ---------- Payments ----------

model PaymentGateway {
  id            String        @id @default(cuid())
  name          String        @unique
  provider      String
  status        GatewayStatus @default(OPERATIONAL)
  successRate   Float         @default(100)
  avgLatencyMs  Int           @default(0)
  todayVolume   Decimal       @default(0) @db.Decimal(18, 2)
  lastCheckedAt DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  transactions Transaction[]

  @@index([status])
}

model Transaction {
  id        String            @id @default(cuid())
  reference String            @unique
  client    Client            @relation(fields: [clientId], references: [id])
  clientId  String
  gateway   PaymentGateway?   @relation(fields: [gatewayId], references: [id])
  gatewayId String?
  type      TransactionType
  method    PaymentMethod
  currency  String
  amount    Decimal           @db.Decimal(18, 2)
  status    TransactionStatus @default(PENDING)
  riskLevel RiskLevel         @default(LOW)
  country   String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([status])
  @@index([type])
  @@index([clientId])
  @@index([gatewayId])
  @@index([createdAt])
}

// ---------- Support & incidents ----------

model Ticket {
  id           String         @id @default(cuid())
  subject      String
  client       Client?        @relation(fields: [clientId], references: [id])
  clientId     String?
  assignedTo   User?          @relation("TicketAssignee", fields: [assignedToId], references: [id])
  assignedToId String?
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(MEDIUM)
  slaDueAt     DateTime?
  createdAt    DateTime       @default(now())
  resolvedAt   DateTime?

  @@index([status])
  @@index([assignedToId])
}

model Incident {
  id          String           @id @default(cuid())
  title       String
  description String
  severity    IncidentSeverity @default(MEDIUM)
  status      IncidentStatus   @default(OPEN)
  owner       User?            @relation("IncidentOwner", fields: [ownerId], references: [id])
  ownerId     String?
  client      Client?          @relation(fields: [clientId], references: [id])
  clientId    String?
  rootCause   String?
  impact      String?
  resolution  String?
  /** Human-readable reference (INC-1024), stable for the incident's whole life.
   *  The list used to number rows by position, so an incident's id changed every
   *  time an older one was opened. */
  ref         Int              @default(autoincrement())
  /** DECLARED by a person, or declared FROM a detection. */
  source      String           @default("DECLARED")
  /** The detector signature this was declared from, if any. One incident per
   *  condition: re-declaring the same live condition reopens rather than
   *  duplicates. */
  signature   String?          @unique
  /** The numbers that justified it, captured at declaration — a detection is
   *  transient and would otherwise be unverifiable an hour later. */
  evidence    Json?
  /** Append-only [{ at, text, by }]. What actually happened, in order. */
  timeline    Json             @default("[]")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  resolvedAt  DateTime?

  categories  IncidentCategoryOnIncident[]

  @@index([status])
  @@index([severity])
}

/// What kind of thing an incident is: "PSP outage", "Deposits", "MT5".
///
/// A table rather than an enum, because the desk finds out what the categories
/// are by running the desk. A fixed list written today is a list somebody has
/// to file real incidents under wrongly next month, and "Other" swallows
/// exactly the pattern that would have been worth naming — so agents add their
/// own, and the list grows out of what actually happened.
model IncidentCategory {
  id        String   @id @default(cuid())
  /// As typed, and shown as typed.
  name      String
  /// Lower-cased and squashed, the key uniqueness is judged on. Without it
  /// "PSP outage", "PSP Outage" and "psp  outage" become three categories that
  /// mean one thing, and every count computed over them is wrong.
  slug      String   @unique
  /// One of the dashboard's accent names, or null to be assigned one. Never a
  /// raw colour: a hex typed into a form is how a category ends up unreadable
  /// in one of the two themes.
  tone      String?
  /// Retired rather than deleted once anything has been filed under it —
  /// deleting would silently rewrite the history of every incident using it.
  active    Boolean  @default(true)
  /// Who added it. The starter set is seeded and has none.
  createdBy String?
  createdAt DateTime @default(now())

  incidents IncidentCategoryOnIncident[]

  @@index([active])
}

/// Many-to-many: an incident is often more than one thing at once. A card
/// declined storm on one PSP is both "PSP outage" and "Deposits", and being
/// made to choose is what makes people choose "Other".
model IncidentCategoryOnIncident {
  incident   Incident         @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  incidentId String
  category   IncidentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId String
  /// Kept so "who tagged this, and when" is answerable — categories drive
  /// which incidents people are shown, so mis-tagging is worth being able to
  /// trace.
  taggedBy   String?
  taggedAt   DateTime         @default(now())

  @@id([incidentId, categoryId])
  @@index([categoryId])
}

// ---------- Reconciliation (config-driven) ----------

// Persisted PSP definitions — the config-driven registry. One row per PSP;
// the whole `config` object is stored as JSON so adding/removing/editing a PSP
// never requires a schema or code change.
model ReconPspConfig {
  id        String   @id // PSP slug (e.g. "paystrax")
  label     String
  config    Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// How far back the historical import has walked, per shop.
//
// The poller reads Paymaxis newest-first and stops at the first page it already
// knows, which is right for staying current and useless for reaching backwards:
// nothing older than the day polling started ever arrives. This cursor lets a
// separate pass walk the list deeper, a bounded slice at a time, and resume
// exactly where it stopped — a serverless invocation is killed at 60s, so a
// backfill that cannot resume can never finish.
model PaymaxisBackfill {
  shopId     String    @id
  /** The next page to read. Pages, not record offsets, so the cursor survives a
   *  change of page size. */
  nextPage   Int       @default(0)
  pages      Int       @default(0)
  fetched    Int       @default(0)
  stored     Int       @default(0)
  /** The oldest payment reached so far — the honest measure of progress, since
   *  the total is unknown until the walk ends. */
  oldestSeen DateTime?
  done       Boolean   @default(false)
  lastError  String?
  /** Held while a step runs, so two invocations cannot walk the same pages. */
  claimedAt  DateTime?
  startedAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// A saved reconciliation run — summary metrics plus the exceptions payload so
// the team can review history without re-uploading files.
model ReconRun {
  id             String   @id @default(cuid())
  ranAt          DateTime @default(now())
  ranBy          String?
  layer1Matched  Int      @default(0)
  layer1Total    Int      @default(0)
  layer2Matched  Int      @default(0)
  layer2Total    Int      @default(0)
  // Chain-level figures. A transaction gets ONE verdict from the whole
  // CRM → Paymaxis → PSP chain, so these — not the per-layer pairs above — are
  // what the history table reports. The pairs are kept for rows written before
  // this column existed, and because a per-leg count is still worth having.
  reconciled     Int      @default(0)
  inScope        Int      @default(0)
  p1             Int      @default(0)
  exceptionCount Int      @default(0)
  exposure       Float    @default(0)
  summary        Json

  @@index([ranAt])
}

// Ops workflow attached to a reconciliation exception. Keyed on the engine's
// stable caseKey so re-running the reconciliation preserves whatever the team
// already recorded (owner, resolution, notes). The denormalised context
// columns let the queue be filtered and reported on without a run payload.
model ReconCase {
  caseKey    String   @id
  resolution String   @default("Open")
  owner      String?
  notes      String?
  priority   String?
  status     String?
  entity     String?
  brand      String?
  psp        String?
  reference  String?
  exposure   Float    @default(0)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@index([resolution])
  @@index([priority])
}

// A payment callback received from a provider (today: Paymaxis).
//
// The raw payload and headers are stored verbatim alongside the normalised
// columns. Provider payloads change without notice and the normalisation is
// best-effort, so keeping the original means nothing is ever lost to a mapping
// gap — the columns can be re-derived later.
model PaymentEvent {
  id              String    @id @default(cuid())
  provider        String
  /// "webhook" (pushed to us) or "poll" (we read it from the API).
  source          String    @default("webhook")
  /// Identity of a payment IN A GIVEN STATE. A payment reappearing as
  /// PENDING -> COMPLETED is news; re-reading it unchanged is not. Unique, so
  /// repeated polls store nothing and the live feed never repeats itself.
  dedupeKey       String?   @unique
  receivedAt      DateTime  @default(now())
  /// False when the callback arrived without a valid signature (capture mode).
  signatureOk     Boolean   @default(false)
  eventType       String?
  paymentId       String?
  /// The PSP's own id for the same payment (Paymaxis externalId == e.g. the
  /// Paystrax UniqueId) — the link between live data and a PSP settlement file.
  externalId      String?
  /// Terminal/connector name, e.g. "Paystrax_Tradin SL" — identifies the PSP.
  terminal        String?
  /// PSP resolved from the terminal, so live data carries the same PSP
  /// dimension the reconciliation groups by.
  psp             String?
  /// For a REFUND, the payment being refunded.
  parentPaymentId String?
  /// On-chain hash for a crypto payment — the join to a crypto PSP's export.
  cryptoTxHash    String?
  /// Provider error code on a failure, e.g. "5.00".
  errorCode       String?
  /// Human-readable failure reason, e.g. "Declined by 3DS".
  errorMessage    String?
  reference       String?
  shop            String?
  /// Jurisdiction derived from the shop, so live data slices the same way the
  /// reconciliation does. Paymaxis shop 5141 is Mauritius, 6321 Saint Lucia.
  entity          String?
  state           String?
  type            String?
  amount          Float     @default(0)
  currency        String?
  customer        String?
  occurredAt      DateTime?
  headers         Json
  payload         Json

  @@index([receivedAt])
  @@index([provider, paymentId])
  @@index([reference])
}

// How far a polling source has been read.
//
// The poller used to hold this in memory, which is correct for a long-running
// process and wrong for a serverless one: every invocation starts with an empty
// map, so each run would re-read the default look-back window instead of only
// what changed. Persisting it makes the poller stateless.
model PollWatermark {
  /// Source and shop, e.g. "paymaxis:5141".
  key       String   @id
  /// ISO timestamp of the newest record seen. Stored as text because it is
  /// echoed straight back to the provider as a query parameter.
  since     String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ---------- Audit ----------

model AuditLog {
  id         String   @id @default(cuid())
  user       User?    @relation(fields: [userId], references: [id])
  userId     String?
  action     String
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  reason     String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

/// A payment provider this dashboard talks to directly.
///
/// Deliberately CONFIGURATION rather than one class per provider. Seven
/// providers arrived at once and more will follow; a bespoke connector each
/// means a deploy to add the eighth, and the "Add PSP" button exists precisely
/// so that adding one is a form rather than a release.
///
/// Everything a request needs is a field here — base URL, how it authenticates,
/// which path to call, where in the response the numbers are. A new provider
/// that speaks JSON over HTTPS needs no code at all.
model PspConnection {
  id       String @id @default(cuid())
  /// The terminal name as Paymaxis reports it — "Paystrax_Tradin SL". Kept
  /// exactly, because it is what joins this row to the payment data already in
  /// the database, and a tidied-up version would join to nothing.
  terminal String @unique
  /// The provider behind it: paystrax, forumpay, aps… Several terminals share
  /// one provider, and therefore one set of endpoint shapes.
  provider String
  /// What a person calls it on screen.
  label    String

  /// Where the API lives, e.g. https://api.provider.com
  baseUrl  String?
  /// bearer | header | basic | query — how the credential is presented.
  authMode String  @default("bearer")
  /// For header/query modes: which header or parameter carries the key.
  authName String?

  /// AES-256-GCM, key from CREDENTIALS_KEY. Never returned by any endpoint.
  /// See common/secret-box.ts for why this is not plaintext and what that does
  /// and does not protect against.
  apiKeyEnc    String?
  apiSecretEnc String?
  /// The last four characters of the key, so somebody who has just pasted one
  /// can confirm the right one landed. Not a general-purpose mask.
  keyHint      String?

  /// Per-capability request shapes: { balance: { path, recordsPath, fields } }.
  /// JSON because the shape differs per provider and per capability, and a
  /// column per field would be a migration every time a provider is added.
  endpoints Json @default("{}")

  /// Off until somebody has filled it in and tested it. A connection that has
  /// never returned anything must not be polled on a schedule, and must not be
  /// reported as working.
  enabled Boolean @default(false)

  /// What the last test or poll did. Reported on the PSPs screen so a broken
  /// connection says so rather than showing a stale balance for ever.
  lastOkAt    DateTime?
  lastTriedAt DateTime?
  lastError   String?

  /// The most recent reading, and when. Kept here rather than in a time series
  /// because the question this answers is "what is the balance now" — the
  /// history that matters is already in the payments themselves.
  balances Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provider])
  @@index([enabled])
}
